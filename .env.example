NEXT_PUBLIC_SITE_URL=https://ondacariocaimoveis.com.br
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=5521987715816

GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_PRIVATE_KEY_BASE64=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Chave secreta configurada no recurso "Formulario de lead" do Google Ads
# (Metodo de entrega de leads > Webhook). Gere um valor aleatorio qualquer.
GOOGLE_ADS_LEAD_FORM_WEBHOOK_KEY=

# Alerta ao corretor quando chega um lead do Formulario de Lead do Google Ads
# (nenhum dos dois e obrigatorio; use o que preferir configurar).
# Opcao 1: URL que recebe um POST com { lead, rowNumber, source } — Make,
# Zapier, n8n, bot de Telegram, endpoint proprio, etc.
NOTIFY_WEBHOOK_URL=
# Opcao 2: WhatsApp direto via CallMeBot (sem custo, sem WhatsApp Business
# API). Ative em https://www.callmebot.com/blog/free-api-whatsapp-messages/
NOTIFY_CALLMEBOT_PHONE=
NOTIFY_CALLMEBOT_APIKEY=
